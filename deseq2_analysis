# RNA-seq Differential Expression Analysis using DESeq2
# Dataset: GSE164073

# Load libraries
library(DESeq2)
library(ggplot2)
library(pheatmap)

# Read count matrix
counts <- read.csv(
  "GSE164073_Eye_count_matrix.csv.gz",
  row.names = 1
)

# Inspect data
head(counts)
dim(counts)

# Create sample metadata
sample_info <- data.frame(
  row.names = colnames(counts),

  condition = c(
    "Mock","Mock","Mock",
    "CoV2","CoV2","CoV2",
    "Mock","Mock","Mock",
    "CoV2","CoV2","CoV2",
    "Mock","Mock","Mock",
    "CoV2","CoV2","CoV2"
  )
)

# Create DESeq2 dataset
dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = sample_info,
  design = ~ condition
)

# Filter low-count genes
dds <- dds[
  rowSums(counts(dds)) >= 10,
]

# Run differential expression analysis
dds <- DESeq(dds)

# Extract results
res <- results(dds)

# View results
head(res)
summary(res)

# Extract significant genes
sig_genes <- subset(
  res,
  padj < 0.05 &
    abs(log2FoldChange) > 1
)

# Number of significant genes
nrow(sig_genes)

# Save DEGs
write.csv(
  as.data.frame(sig_genes),
  "DEGs.csv"
)

# Variance stabilizing transformation
vsd <- vst(dds)

# PCA Plot
plotPCA(
  vsd,
  intgroup = "condition"
)

# MA Plot
plotMA(res)

# Heatmap of top variable genes
topgenes <- head(
  order(
    rowVars(assay(vsd)),
    decreasing = TRUE
  ),
  50
)

pheatmap(
  assay(vsd)[topgenes, ],
  scale = "row"
)

# Volcano Plot
library(EnhancedVolcano)

EnhancedVolcano(
  res,
  lab = rownames(res),
  x = "log2FoldChange",
  y = "padj"
)
